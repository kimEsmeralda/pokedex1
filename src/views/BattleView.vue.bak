<template>
  <div class="battle-container">
    <div class="battle-header">
      <router-link to="/" class="btn-back">? Volver</router-link>
      <h1>Batalla Pokémon</h1>
    </div>

    <div class="battle-content" v-if="!isBattling && !battleFinished">
      <div class="team-selector">
        <h2>Selecciona tu equipo</h2>
        <div v-if="userStore.teams.length === 0" class="empty">
          No tienes equipos. Crea uno primero.
        </div>
        <div v-else class="teams-available">
          <div
            v-for="team in userStore.teams"
            :key="team.id"
            class="team-option"
            @click="selectTeam(team)"
            :class="{ selected: selectedTeam?.id === team.id }"
          >
            <h3>{{ team.name }}</h3>
            <p>{{ team.pokemon?.length || 0 }}/6 Pokémon</p>
            <ul v-if="team.pokemon?.length">
              <li v-for="p in team.pokemon" :key="p.id">
                {{ p.pokemonName }}
              </li>
            </ul>
          </div>
        </div>
      </div>

      <div class="battle-simulation" v-if="selectedTeam">
        <h2>vs {{ friendName }}</h2>
        <p class="info">
          Selecciona Iniciar Batalla para enfrentarte al equipo de {{ friendName }}.
        </p>

        <div class="team-info">
          <h3>Tu equipo:</h3>
          <div v-for="pokemon in selectedTeam.pokemon" :key="pokemon.id" class="pokemon-info">
            <span>{{ pokemon.pokemonName }}</span>
          </div>
        </div>

        <button @click="startBattle" class="btn-start-battle" :disabled="loading">
          {{ loading ? "Iniciando..." : "Iniciar Batalla" }}
        </button>
      </div>
    </div>

    <div class="battle-arena" v-else-if="isBattling">
      <h2>Combate en curso...</h2>
      
      <div class="arena-layout">
        <!-- Player Pokemon -->
        <div class="fighter player-fighter" v-if="currentPokemon1">
          <h3>{{ currentPokemon1.pokemonName }} (Tú)</h3>
          <div class="health-bar">
            <div class="health-fill" :style="{ width: currentPokemon1.hp + '%' }"></div>
          </div>
          <p>HP: {{ currentPokemon1.hp }} / 100</p>
        </div>

        <div class="vs-text">VS</div>

        <!-- Friend Pokemon -->
        <div class="fighter enemy-fighter" v-if="currentPokemon2">
          <h3>{{ currentPokemon2.pokemonName }} ({{ friendName }})</h3>
          <div class="health-bar enemy-health">
            <div class="health-fill" :style="{ width: currentPokemon2.hp + '%' }"></div>
          </div>
          <p>HP: {{ currentPokemon2.hp }} / 100</p>
        </div>
      </div>

      <div class="battle-log">
        <p v-for="(log, idx) in battleLogs" :key="idx">{{ log }}</p>
      </div>
    </div>

    <div class="battle-result" v-else-if="battleFinished">
      <h2>¡Batalla Finalizada!</h2>
      <h3 :class="{ 'win-text': isWinner, 'lose-text': !isWinner }">
        {{ isWinner ? '¡Has ganado!' : 'Has perdido...' }}
      </h3>
      <button @click="resetBattle" class="btn-start-battle">Volver</button>
    </div>
  </div>
</template>

<script setup>
import { ref, onMounted } from 'vue';
import { useRoute, useRouter } from 'vue-router';
import { useUserStore } from '../stores/userStore.js';
import { friendsService } from '../services/api.js';

const route = useRoute();
const router = useRouter();
const userStore = useUserStore();

const friendId = parseInt(route.params.friendId);
const friendName = ref("");
const selectedTeam = ref(null);
const loading = ref(false);

const isBattling = ref(false);
const battleFinished = ref(false);
const isWinner = ref(false);
const battleId = ref(null);

const team1Active = ref([]);
const team2Active = ref([]);
const currentPokemon1 = ref(null);
const currentPokemon2 = ref(null);
const battleLogs = ref([]);

onMounted(async () => {
  await userStore.fetchTeams();
  await userStore.fetchFriends();

  const friend = userStore.friends.find((f) => f.id === friendId);
  if (friend) {
    friendName.value = friend.username;
  }
});

function selectTeam(team) {
  selectedTeam.value = team;
}

async function startBattle() {
  if (!selectedTeam.value) {
    alert("Debes seleccionar un equipo");
    return;
  }
  if (!selectedTeam.value.pokemon || selectedTeam.value.pokemon.length === 0) {
    alert("Tu equipo está vacío");
    return;
  }

  loading.value = true;
  try {
    const res = await friendsService.startBattle(friendId, selectedTeam.value.id, null);
    battleId.value = res.data.battleId;
    
    // Prep fighters (add HP)
    team1Active.value = res.data.teams.team1.pokemon.map(p => ({ ...p, hp: 100 }));
    team2Active.value = res.data.teams.team2.pokemon.map(p => ({ ...p, hp: 100 }));
    
    if (team2Active.value.length === 0) {
       alert("El oponente no tiene Pokémon en su equipo");
       return;
    }

    currentPokemon1.value = team1Active.value.shift();
    currentPokemon2.value = team2Active.value.shift();
    
    isBattling.value = true;
    battleLogs.value = ["¡Comienza la batalla!"];
    
    simulateTurn();
  } catch (error) {
    console.error(error);
    alert("Error iniciando batalla: " + (error.response?.data?.error || error.message));
  } finally {
    loading.value = false;
  }
}

function simulateTurn() {
  setTimeout(() => {
    if (!isBattling.value) return;

    // determine attacker
    const attackerIsPlayer = Math.random() > 0.5;
    const damage = Math.floor(Math.random() * 20) + 15; // 15 to 34 damage
    const specialMove = Math.random() > 0.8 ? "¡Golpe Crítico!" : "usa un ataque.";

    if (attackerIsPlayer) {
      currentPokemon2.value.hp = Math.max(0, currentPokemon2.value.hp - damage);
      battleLogs.value.push(\\ \ Hace \ de daño a \.\);
    } else {
      currentPokemon1.value.hp = Math.max(0, currentPokemon1.value.hp - damage);
      battleLogs.value.push(\\ \ Hace \ de daño a \.\);
    }

    // Keep max 5 logs
    if (battleLogs.value.length > 6) battleLogs.value.shift();

    checkFaint();
  }, 1000);
}

function checkFaint() {
  if (currentPokemon1.value.hp <= 0) {
    battleLogs.value.push(\¡\ se ha debilitado!\);
    if (team1Active.value.length > 0) {
      currentPokemon1.value = team1Active.value.shift();
      battleLogs.value.push(\¡Adelante, \!\);
      simulateTurn();
    } else {
      finishBattle(false);
    }
  } else if (currentPokemon2.value.hp <= 0) {
    battleLogs.value.push(\¡\ enemigo se ha debilitado!\);
    if (team2Active.value.length > 0) {
      currentPokemon2.value = team2Active.value.shift();
      battleLogs.value.push(\\ envía a \.\);
      simulateTurn();
    } else {
      finishBattle(true);
    }
  } else {
    simulateTurn();
  }
}

async function finishBattle(win) {
  isBattling.value = false;
  battleFinished.value = true;
  isWinner.value = win;

  const winnerId = win ? userStore.user.id : friendId;
  
  try {
    await friendsService.calculateBattleResult(battleId.value, winnerId);
  } catch (error) {
    console.error("Error guardando el resultado:", error);
  }
}

function resetBattle() {
  battleFinished.value = false;
  selectedTeam.value = null;
}
</script>

<style scoped>
.battle-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding-bottom: 2rem;
}

.battle-header {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 2rem;
  background: rgba(0, 0, 0, 0.1);
  color: white;
}

.btn-back {
  padding: 0.5rem 1rem;
  background: rgba(255, 255, 255, 0.2);
  color: white;
  text-decoration: none;
  border-radius: 5px;
  cursor: pointer;
}

.battle-content {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2rem;
  padding: 2rem;
  max-width: 1200px;
  margin: 0 auto;
}

.team-selector,
.battle-simulation,
.battle-arena,
.battle-result {
  background: white;
  padding: 2rem;
  border-radius: 10px;
  box-shadow: 0 4px 6px rgba(0,0,0,0.1);
}

.battle-arena {
  max-width: 800px;
  margin: 2rem auto;
  text-align: center;
}

.arena-layout {
  display: flex;
  justify-content: space-around;
  align-items: center;
  margin: 2rem 0;
}

.fighter {
  width: 40%;
  padding: 1rem;
  background: #f8f9fa;
  border-radius: 8px;
  border: 2px solid #ddd;
}

.player-fighter { border-color: #27ae60; }
.enemy-fighter { border-color: #e74c3c; }

.health-bar {
  width: 100%;
  height: 20px;
  background: #eee;
  border-radius: 10px;
  overflow: hidden;
  margin: 1rem 0;
}

.health-fill {
  height: 100%;
  background: #27ae60;
  transition: width 0.3s ease;
}

.enemy-health .health-fill { background: #e74c3c; }

.vs-text {
  font-size: 2rem;
  font-weight: bold;
  color: #666;
}

.battle-log {
  margin-top: 2rem;
  padding: 1rem;
  background: #333;
  color: #fff;
  border-radius: 8px;
  height: 150px;
  overflow-y: auto;
  text-align: left;
}

.battle-log p {
  margin: 0.5rem 0;
  border-bottom: 1px solid #444;
  padding-bottom: 0.25rem;
}

.battle-result {
  max-width: 600px;
  margin: 2rem auto;
  text-align: center;
}

.win-text { color: #27ae60; font-size: 2rem; }
.lose-text { color: #e74c3c; font-size: 2rem; }

.team-selector h2,
.battle-simulation h2 {
  margin-top: 0;
  color: #333;
}

.empty {
  text-align: center;
  color: #999;
  padding: 2rem;
}

.teams-available {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.team-option {
  padding: 1rem;
  border: 2px solid #ddd;
  border-radius: 5px;
  cursor: pointer;
  transition: all 0.3s;
}

.team-option:hover,
.team-option.selected {
  border-color: #667eea;
  background: #f0f0ff;
}

.team-option h3 {
  margin: 0;
  color: #333;
}

.btn-start-battle {
  width: 100%;
  padding: 1rem;
  background: #27ae60;
  color: white;
  border: none;
  border-radius: 5px;
  font-size: 1rem;
  font-weight: 600;
  cursor: pointer;
  margin-top: 1rem;
}

.btn-start-battle:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

@media (max-width: 768px) {
  .battle-content, .arena-layout {
    grid-template-columns: 1fr;
    flex-direction: column;
    gap: 1rem;
  }
  .fighter { width: 100%; }
}
</style>

